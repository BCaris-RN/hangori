    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.1",
    "fast-check": "^3.23.2",
